# Bermatik web — ayar örneği. Bu dosyayı ".env.local" adıyla kopyalayıp doldurun.
# Gerçek değerler ASLA GitHub'a yüklenmez.

# Veritabanı (Microsoft SQL Server)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=BermatikDev
DB_USER=
DB_PASSWORD=
# Yalnızca yerel geliştirme: SQL Server'ın kendi sertifikasına güven
DB_TRUST_SERVER_CERT=true

# E-posta (Gmail uygulama şifresi: myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Tarayıcı bildirimleri (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Rastgele uzun metinler (örn. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ILETI_SECRET=
AUTH_SECRET=

# Google ile giriş (boş bırakılırsa buton gizlenir)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Bir proxy/tünel arkasındaysa 1
TRUST_PROXY=0

# Sitenin herkese açık adresi
SITE_URL=http://localhost:3000
